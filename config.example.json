{
  "_comment": "Copy this file to ~/.minion-assist/config.json and fill in your credentials. Never commit the real config.json to version control — it contains secrets.",
  "models": {
    "providers": {
      "openai": {
        "api": "codex",
        "models": [
          {
            "id": "gpt-5.5",
            "name": "GPT-5.5 (Codex subscription)",
            "inputModalities": ["text"],
            "contextWindow": 200000,
            "maxOutputTokens": 100000
          }
        ]
      },
      "volces": {
        "baseUrl": "https://ark.cn-beijing.volces.com/api/plan/v3",
        "api": "openai-completions",
        "models": [
          {
            "id": "glm-5.2",
            "name": "GLM-5.2 (Volcengine Ark)",
            "inputModalities": ["text"],
            "contextWindow": 128000,
            "maxOutputTokens": 4096
          }
        ]
      },
      "lmstudio": {
        "baseUrl": "http://127.0.0.1:1234/v1",
        "api": "lmstudio",
        "models": [
          {
            "id": "qwen-qwen3.5-9b",
            "name": "Qwen 3.5 9B",
            "contextWindow": 262144,
            "maxOutputTokens": 32768
          }
        ]
      }
    }
  },
  "agents": {
    "main": {
      "model": "openai/gpt-5.5"
    },
    "researcher": {
      "model": "lmstudio/qwen-qwen3.5-9b",
      "route_prefix": "/research"
    }
  },
  "workspace": {
    "path": "~/.minion-assist"
  },
  "streaming": {
    "chat_mode": true,
    "task_mode": false
  },
  "compaction": {},
  "channels": {
    "matrix": {
      "homeserver": "https://matrix.your-homeserver.org",
      "userId": "@bot:your-homeserver.org",
      "accessToken": "YOUR_MATRIX_ACCESS_TOKEN",
      "groups": {
        "!YOUR_ROOM_ID:your-homeserver.org": {}
      }
    }
  },
  "database": {
    "url": "postgresql://minion:minion@localhost:5433/minion_assist"
  },
  "voice": {
    "enabled": false,
    "language": "en",
    "vad": {
      "threshold": 0.7,
      "silence_ms": 1200
    },
    "stt": {
      "model": "whisper",
      "whisper_model_id": "openai/whisper-large-v3",
      "parakeet_model_id": "nvidia/parakeet-tdt-0.6b-v3",
      "device": "cuda"
    },
    "tts": {
      "model": "kokoro",
      "kokoro_voice": "af_heart",
      "qwen3_model_id": "Qwen/Qwen3-TTS-12Hz-1.7B-CustomVoice",
      "qwen3_precision": "bf16",
      "qwen3_speaker": "Vivian",
      "piper_model_path": "",
      "voice_ref_audio": null,
      "device": "cuda"
    },
    "audio": {
      "input_device": null,
      "output_device": null,
      "sample_rate": 16000
    }
  },
  "mcp": {
    "servers": {
      "playwright": {
        "transport": "stdio",
        "command": "npx",
        "args": ["@playwright/mcp@latest"],
        "tool_timeout": 60,
        "enabled_tools": ["*"]
      }
    }
  }
}
